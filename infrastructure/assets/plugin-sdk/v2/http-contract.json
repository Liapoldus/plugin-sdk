{
  "contractVersion": "liapoldus.plugin-sdk.http.v2",
  "transportSecurity": {
    "minimumTLSVersion": 772,
    "clientCertificateRequired": true,
    "trustDomain": "core-control-plane",
    "peerIdentity": {
      "commonNameRequired": true,
      "commonNameMaximumLength": 256,
      "uniformResourceIdentifierPrefix": "spiffe://liapoldus/core/",
      "revocationFailClosed": true
    }
  },
  "identity": {
    "replica": {
      "maximumBytes": 256,
      "fields": [
        "instanceId",
        "replicaId"
      ]
    },
    "registration": {
      "mediaType": "application/json",
      "maximumBytes": 4096,
      "required": [
        "contractVersion",
        "instanceId",
        "replicaId",
        "appliedGeneration",
        "ready"
      ]
    }
  },
  "plugin": {
    "responses": {
      "health": {
        "status": 200,
        "body": {
          "status": "ok"
        }
      },
      "contentTypes": {
        "json": "application/json",
        "metrics": "text/plain; version=0.0.4; charset=utf-8"
      },
      "metrics": {
        "readyMetricName": "liapoldus_plugin_ready",
        "readyMetricHelp": "Whether the plugin has an active configuration generation.",
        "lifecycleCounterName": "liapoldus_plugin_lifecycle_total",
        "lifecycleCounterHelp": "Count of plugin lifecycle operations by kind and bounded outcome.",
        "lifecycleCounterKindLabel": "kind",
        "lifecycleCounterOutcomeLabel": "outcome",
        "pullFailureCounterName": "liapoldus_plugin_config_pull_failures_total",
        "pullFailureCounterHelp": "Count of exact-generation configuration pull attempts that did not yield an applicable document."
      }
    },
    "endpoints": {
      "adminAction": {
        "method": "POST",
        "path": "/_liapoldus/v1/admin-action/{page}/{action}"
      },
      "adminSurface": {
        "method": "GET",
        "path": "/_liapoldus/v1/admin-surface"
      },
      "artifactStream": {
        "method": "POST",
        "path": "/_liapoldus/v1/artifact-stream"
      },
      "configSchema": {
        "method": "GET",
        "path": "/_liapoldus/v1/config-schema"
      },
      "health": {
        "method": "GET",
        "path": "/_liapoldus/v1/health"
      },
      "identity": {
        "method": "GET",
        "path": "/_liapoldus/v1/identity"
      },
      "manifest": {
        "method": "GET",
        "path": "/_liapoldus/v1/manifest"
      },
      "metrics": {
        "method": "GET",
        "path": "/_liapoldus/v1/metrics"
      },
      "ready": {
        "method": "GET",
        "path": "/_liapoldus/v1/ready"
      },
      "reload": {
        "method": "POST",
        "path": "/_liapoldus/v1/reload"
      }
    },
    "reloadRequest": {
      "mediaType": "application/json",
      "maximumBytes": 4096,
      "required": [
        "generation",
        "sha256",
        "schemaVersion"
      ]
    },
    "reloadAcknowledgement": {
      "mediaType": "application/json",
      "maximumBytes": 4096,
      "required": [
        "generation",
        "sha256",
        "schemaVersion",
        "applied",
        "outcome"
      ]
    },
    "readiness": {
      "mediaType": "application/json",
      "maximumBytes": 4096,
      "required": [
        "ready",
        "generation",
        "sha256",
        "schemaVersion",
        "pendingGeneration",
        "instanceId",
        "replicaId"
      ]
    },
    "manifest": {
      "mediaType": "application/json",
      "maximumBytes": 262144
    },
    "configurationSchema": {
      "mediaType": "application/json",
      "maximumBytes": 262144
    },
    "maximumMetadataBytes": 262144,
    "artifactStream": {
      "mediaType": "multipart/form-data",
      "metadataMediaType": "application/json",
      "parts": [
        "metadata",
        "artifact"
      ],
      "partOrder": [
        "metadata",
        "artifact"
      ],
      "maximumArtifactBytes": 134217728,
      "minimumArtifactBytes": 1,
      "maximumMetadataBytes": 65536,
      "maximumMultipartOverheadBytes": 65536,
      "maximumRequestBytes": 134348800,
      "maximumReceiptBytes": 4096,
      "acceptedStatus": 202,
      "filenameForwarded": false,
      "invocationContext": {
        "maximumBytes": 8192,
        "required": [
          "callerId",
          "instanceId",
          "pageId",
          "actionId",
          "surfaceDigest",
          "idempotencyKey",
          "requestId"
        ],
        "optional": [
          "ifMatch"
        ],
        "headers": {
          "actionId": "Liapoldus-Action",
          "callerId": "Liapoldus-Caller",
          "idempotencyKey": "Idempotency-Key",
          "ifMatch": "If-Match",
          "instanceId": "Liapoldus-Instance",
          "pageId": "Liapoldus-Page",
          "requestId": "Liapoldus-Request-ID",
          "surfaceDigest": "Liapoldus-Surface-Digest"
        }
      }
    },
    "adminSurface": {
      "mediaType": "application/json",
      "maximumBytes": 262144,
      "digestAlgorithm": "SHA-256"
    },
    "adminAction": {
      "mediaType": "application/json",
      "maximumRequestBytes": 1048576,
      "maximumResponseBytes": 1048576,
      "maximumPageIdBytes": 128,
      "maximumActionIdBytes": 128,
      "pathSegmentPattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$",
      "responseStatus": {
        "minimum": 200,
        "maximum": 599
      },
      "deadlineSeconds": 30,
      "invocationContext": {
        "maximumBytes": 8192,
        "unknownHeaderPrefix": "Liapoldus-",
        "required": [
          "callerId",
          "instanceId",
          "pageId",
          "actionId",
          "surfaceDigest",
          "requestId"
        ],
        "optional": [
          "idempotencyKey",
          "ifMatch"
        ],
        "headers": {
          "actionId": "Liapoldus-Action",
          "callerId": "Liapoldus-Caller",
          "idempotencyKey": "Idempotency-Key",
          "ifMatch": "If-Match",
          "instanceId": "Liapoldus-Instance",
          "pageId": "Liapoldus-Page",
          "requestId": "Liapoldus-Request-ID",
          "surfaceDigest": "Liapoldus-Surface-Digest"
        }
      }
    }
  },
  "core": {
    "configPull": {
      "method": "GET",
      "pathTemplate": "/internal/v1/plugin-config/{generation}",
      "responseMediaType": "application/json",
      "maximumBytes": 262144,
      "requestMediaType": "application/json",
      "generationStates": [
        "active",
        "previous"
      ],
      "responseHeaders": {
        "generation": "Liapoldus-Generation",
        "generationState": "Liapoldus-Generation-State",
        "schemaVersion": "Liapoldus-Schema-Version",
        "sha256": "Liapoldus-SHA256"
      }
    },
    "secretGrant": {
      "issue": {
        "method": "POST",
        "pathTemplate": "/internal/v1/plugin-secret-grants",
        "requestMediaType": "application/json",
        "responseMediaType": "application/json",
        "maximumRequestBytes": 4096,
        "maximumResponseBytes": 4096,
        "required": [
          "reference",
          "purpose",
          "generation"
        ]
      },
      "redemption": {
        "method": "POST",
        "pathTemplate": "/internal/v1/plugin-secret-grants/{handle}/redemption",
        "requestMediaType": "application/json",
        "responseMediaType": "application/json",
        "maximumRequestBytes": 4096,
        "maximumResponseBytes": 65536,
        "required": [
          "handle"
        ]
      },
      "handleMaximumLength": 512,
      "referenceMaximumLength": 512,
      "purposeMaximumLength": 128,
      "redemptionUseLimit": 1
    }
  },
  "outcomes": {
    "reload": [
      "applied",
      "alreadyActive",
      "invalidRequest",
      "notPermitted",
      "unknownGeneration",
      "staleGeneration",
      "generationConflict",
      "digestMismatch",
      "schemaVersionMismatch",
      "documentMalformed",
      "documentOversized",
      "applyRejected",
      "coreUnavailable",
      "cancelled",
      "deadlineExceeded"
    ],
    "configPull": [
      "succeeded",
      "notPermitted",
      "unknownGeneration",
      "staleGeneration",
      "digestMismatch",
      "schemaVersionMismatch",
      "documentMalformed",
      "documentOversized",
      "coreUnavailable",
      "cancelled",
      "deadlineExceeded"
    ],
    "secretRedemption": [
      "granted",
      "notPermitted",
      "grantUnknown",
      "grantDenied",
      "grantExpired",
      "grantSpent",
      "coreUnavailable",
      "cancelled",
      "deadlineExceeded"
    ]
  },
  "problems": {
    "internalError": {
      "status": 500,
      "code": "internal_error"
    },
    "methodNotAllowed": {
      "status": 405,
      "code": "method_not_allowed"
    },
    "notFound": {
      "status": 404,
      "code": "not_found"
    },
    "payloadOversized": {
      "status": 413,
      "code": "payload_oversized"
    },
    "unsupportedMediaType": {
      "status": 415,
      "code": "unsupported_media_type"
    }
  },
  "outcomeProblems": {
    "applyRejected": "applyRejected",
    "cancelled": "cancelled",
    "coreUnavailable": "coreUnavailable",
    "deadlineExceeded": "deadlineExceeded",
    "digestMismatch": "digestMismatch",
    "documentMalformed": "documentMalformed",
    "documentOversized": "documentOversized",
    "generationConflict": "generationConflict",
    "grantDenied": "grantDenied",
    "grantExpired": "grantExpired",
    "grantSpent": "grantSpent",
    "grantUnknown": "grantUnknown",
    "invalidRequest": "invalidRequest",
    "notPermitted": "notPermitted",
    "schemaVersionMismatch": "schemaVersionMismatch",
    "staleGeneration": "staleGeneration",
    "unknownGeneration": "unknownGeneration"
  },
  "successOutcomes": [
    "applied",
    "alreadyActive",
    "succeeded",
    "granted"
  ],
  "errors": {
    "applyRejected": {
      "status": 422,
      "code": "configuration_rejected"
    },
    "cancelled": {
      "status": 503,
      "code": "cancelled"
    },
    "configurationUnavailable": {
      "status": 502,
      "code": "configuration_unavailable"
    },
    "coreUnavailable": {
      "status": 502,
      "code": "core_unavailable"
    },
    "deadlineExceeded": {
      "status": 504,
      "code": "deadline_exceeded"
    },
    "digestMismatch": {
      "status": 502,
      "code": "digest_mismatch"
    },
    "documentMalformed": {
      "status": 502,
      "code": "configuration_malformed"
    },
    "documentOversized": {
      "status": 502,
      "code": "configuration_oversized"
    },
    "generationConflict": {
      "status": 409,
      "code": "generation_conflict"
    },
    "grantDenied": {
      "status": 403,
      "code": "secret_grant_denied"
    },
    "grantExpired": {
      "status": 403,
      "code": "secret_grant_expired"
    },
    "grantSpent": {
      "status": 403,
      "code": "secret_grant_spent"
    },
    "grantUnknown": {
      "status": 404,
      "code": "secret_grant_unknown"
    },
    "invalidRequest": {
      "status": 400,
      "code": "invalid_request"
    },
    "notPermitted": {
      "status": 403,
      "code": "not_permitted"
    },
    "notReady": {
      "status": 503,
      "code": "not_ready"
    },
    "schemaVersionMismatch": {
      "status": 502,
      "code": "schema_version_mismatch"
    },
    "staleGeneration": {
      "status": 409,
      "code": "generation_stale"
    },
    "unknownGeneration": {
      "status": 404,
      "code": "generation_unknown"
    }
  },
  "deadlines": {
    "pluginReloadSeconds": 30,
    "pluginReadinessSeconds": 5,
    "coreConfigPullSeconds": 10,
    "coreSecretGrantSeconds": 10,
    "coreSecretRedemptionSeconds": 10,
    "pluginReadHeaderSeconds": 5,
    "pluginReadSeconds": 15,
    "pluginWriteSeconds": 60,
    "pluginIdleSeconds": 120,
    "pluginShutdownGraceSeconds": 20,
    "clientResponseHeaderSeconds": 10,
    "clientDialSeconds": 10,
    "artifactStreamSeconds": 600
  },
  "logging": {
    "stream": "stdout",
    "levels": [
      "debug",
      "info",
      "warn",
      "error"
    ],
    "defaultLevel": "info",
    "maximumFields": 24,
    "maximumKeyLength": 64,
    "maximumValueLength": 256,
    "redactedPlaceholder": "[redacted]",
    "redactedKeys": [
      "authorization",
      "certificate",
      "config",
      "cookie",
      "document",
      "dsn",
      "grant",
      "handle",
      "key",
      "password",
      "private",
      "secret",
      "settings",
      "token",
      "value"
    ],
    "alwaysRedactedKeys": [
      "authorization",
      "cookie",
      "document",
      "grant",
      "handle",
      "password",
      "privatekey",
      "secret",
      "settings",
      "token"
    ]
  },
  "idempotency": {
    "reloadKeyedBy": [
      "instanceId",
      "replicaId",
      "generation",
      "sha256",
      "schemaVersion"
    ],
    "repeatOfActiveGeneration": "alreadyActive",
    "conflictingDescriptorForActiveGeneration": "generationConflict"
  }
}
